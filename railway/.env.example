# ==============================================================================
# RAILWAY BACKEND - ENVIRONMENT VARIABLES (.env)
# Set these in your Railway Project Service -> Variables
# ==============================================================================

# Railway Service Port (Default 8080)
PORT=8080
NODE_ENV="production"
RAILWAY_ENVIRONMENT="production"

# WhatsApp Session ID (Exported base64/zipped string from web dashboard)
# Is variable se container har deployment par automatically connect ho jata hai
SESSION_ID=""

# Bot Identity & Admin Privileges
BOT_NAME="ZAID ASHIQ STUDIO"
BOT_PREFIX="/"
OWNER_NUMBER="923001234567"
OWNER_NAME="Zahid Ashiq"
WORK_TYPE="public"
TIMEZONE="Asia/Karachi"

# Public Railway Service Domain (Provided by Railway in Networking settings)
RAILWAY_BACKEND_URL="https://your-bot-name.up.railway.app"

# Optional Cloudinary Media Storage (For Video Notes, Voice Notes, Statuses)
CLOUDINARY_URL=""
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# Optional Automated Session Backup to GitHub Gist
GITHUB_TOKEN=""
GITHUB_GIST_ID=""
