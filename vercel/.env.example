# ==============================================================================
# ZAID ASHIQ STUDIO - FRONTEND (VERCEL) ENVIRONMENT VARIABLES
# ==============================================================================

# ── 1. Backend Service URL (Choose ONE according to your backend host) ────────
# Agar aapka backend Render par deploy hai:
RENDER_BACKEND_URL=https://your-bot-backend.onrender.com

# Agar aapka backend Railway par deploy hai:
RAILWAY_BACKEND_URL=https://your-bot-backend.up.railway.app

# Agar aapka backend Heroku par deploy hai:
HEROKU_BACKEND_URL=https://your-bot-backend.herokuapp.com

# Generic Fallback (agar upar walay use na karein):
# BACKEND_URL=https://your-bot-backend.example.com

# ── 2. Google Identity & OAuth 2.0 (Strict Security Gate) ────────────────────
# Google Cloud Console se Web Client ID copy karein:
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# ── 3. Cloudinary & GitHub (Optional on Frontend for Status Flags) ────────────
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
