# ==============================================================================
# VERCEL FRONTEND - ENVIRONMENT CONFIGURATION (.env)
# Set these in your Vercel Project Settings -> Environment Variables
# NOTE: DO NOT ADD SESSION_ID IN VERCEL!
# Har client/user apna Session ID Vercel Frontend UI par apna Gmail enter kar ke
# direct bind aur run karta hai, jo backend aur GitHub Gist par log ho jata hai.
# ==============================================================================

# Target Backend Server URLs (Vercel Frontend automatically detects which one is online!)
# Configure one, two, or all three of Render, Railway, and Heroku:
RENDER_BACKEND_URL="https://your-bot-service.onrender.com"
RAILWAY_BACKEND_URL="https://your-bot-service.up.railway.app"
HEROKU_BACKEND_URL="https://your-bot-app.herokuapp.com"
BACKEND_URL="http://localhost:3000"

# Application Brand Display Name
VITE_APP_TITLE="ZAID ASHIQ STUDIO - WhatsApp Control Panel"

# Default Timezone for Online Tracer & Presence Logs
VITE_DEFAULT_TIMEZONE="Asia/Karachi"

# Optional Google OAuth Client ID (if using 1-time Google account session locking)
VITE_GOOGLE_CLIENT_ID=""
