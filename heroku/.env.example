# ==============================================================================
# HEROKU BACKEND - ENVIRONMENT VARIABLES (.env / Config Vars)
# Set these in your Heroku App -> Settings -> Config Vars
# ==============================================================================

# Note: Do NOT set PORT manually on Heroku; Heroku injects dynamic $PORT automatically.
NODE_ENV="production"

# WhatsApp Session ID (Exported base64/zipped string from web dashboard)
# Is variable se Heroku Dyno rozana restart hone par bhi connected rehta hai
SESSION_ID=""

# Bot Identity & Admin Privileges
BOT_NAME="ZAID ASHIQ STUDIO"
BOT_PREFIX="/"
OWNER_NUMBER="923001234567"
OWNER_NAME="Zahid Ashiq"
WORK_TYPE="public"
TIMEZONE="Asia/Karachi"

# Public Heroku App URL (e.g. https://your-bot-app.herokuapp.com)
HEROKU_BACKEND_URL="https://your-bot-name.herokuapp.com"

# Optional Cloudinary Media Storage (For Video Notes, Voice Notes, Statuses)
CLOUDINARY_URL=""
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# Optional Automated Session Backup to GitHub Gist
GITHUB_TOKEN=""
GITHUB_GIST_ID=""
