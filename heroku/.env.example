# ==============================================================================
# ZAID ASHIQ STUDIO - BACKEND HEROKU PRODUCTION ENVIRONMENT
# ==============================================================================

# Server Port (Heroku automatically sets $PORT dynamic variable)
PORT=3000
NODE_ENV=production

# ── Admin & Security ─────────────────────────────────────────────────────────
ADMIN_NUMBER=9232999931199
API_SECRET=zaid-ashiq-secret-2026

# ── Google OAuth Client ID (Strict Admin Authentication) ─────────────────────
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# ── WhatsApp Session Credentials ─────────────────────────────────────────────
# Optional: Agar pehle se saved session ho toh yahan dalein, warna QR/Pairing Code use karein
SESSION_ID=

# ── Cloudinary Media CDN Hosting ─────────────────────────────────────────────
# Voice notes, video notes, status media aur pictures host karne ke liye
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ── GitHub Automated Session Gist Backup ──────────────────────────────────────
# Heroku dyno daily restart / cycle hone par session automatically restore karne ke liye
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_GIST_ID=
