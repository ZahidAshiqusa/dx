# ==============================================================================
# ZAID ASHIQ STUDIO - MULTI-CLOUD PRODUCTION ENVIRONMENT CONFIGURATION
# Supports Vercel, Railway, GitHub, Cloudinary, and Google Identity
# ==============================================================================

# Server Port (default 3000 for AI Studio and Railway)
PORT=3000
NODE_ENV=production

# ── 1. Vercel, Render, Railway & Heroku Interconnect ───────────────────────
# Set this in Vercel Project Settings -> Environment Variables
# If deploying backend on Render:
RENDER_BACKEND_URL=https://your-bot-backend.onrender.com
# If deploying backend on Railway:
RAILWAY_BACKEND_URL=https://your-bot-backend.up.railway.app
# If deploying backend on Heroku:
HEROKU_BACKEND_URL=https://your-bot-backend.herokuapp.com

# ── 2. Google Identity & OAuth ────────────────────────────────────────────────
# Google Cloud Console OAuth 2.0 Web Client ID
# Configured in both Vercel and Railway for strict identity gating
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# ── 3. WhatsApp Baileys Authentication & Session ──────────────────────────────
# Optional; if not provided, link device via QR Code, Pairing Code, or Session ID tab
SESSION_ID=

# WhatsApp Bot API Authentication Secret
API_SECRET=zaid-ashiq-secret-2026

# Admin WhatsApp Phone Number(s) (comma-separated, country code + digits, no +)
ADMIN_NUMBER=9232999931199

# ── 4. Cloudinary CDN Media Hosting ───────────────────────────────────────────
# Offloads Voice Notes (PTT), Video Notes (PTV), Profile Pictures, and Status Media
# Format A: Single Connection URL
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Format B: Discrete Variables (alternative)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=123456789012345
# CLOUDINARY_API_SECRET=your_api_secret

# ── 5. GitHub Automated Session & Credential Backup ───────────────────────────
# Personal Access Token (classic with `gist` scope or fine-grained with Gists read/write)
# Auto-backs up creds.json and restores on ephemeral container/dyno restarts
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional; auto-populated on first backup. Set explicitly if restoring an existing Gist
GITHUB_GIST_ID=
