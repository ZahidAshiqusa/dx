# ==============================================================================
# ZAID ASHIQ STUDIO - MASTER PRODUCTION ENVIRONMENT CONFIGURATION (.env)
# Comprehensive template for WhatsApp Power Bot & Multi-Cloud Control Panel
# Compatible with Local Dev, Vercel, Railway, Render, and Heroku
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BOT IDENTITY & CORE SETTINGS (بنیادی بوٹ سیٹنگز)
# ------------------------------------------------------------------------------
# Display name of your bot shown in interactive messages and status responses
BOT_NAME="ZAID ASHIQ STUDIO"

# Command trigger character (e.g. / or ! or .)
BOT_PREFIX="/"

# Primary Owner WhatsApp phone number with country code (no + or -)
# Maslan: 923001234567 ya 14155552671
OWNER_NUMBER="923001234567"

# Owner display name
OWNER_NAME="Zahid Ashiq"

# Mode: 'public' (everyone can use commands) or 'private' (owner-only access)
WORK_TYPE="public"

# Timezone for Online Tracer & Deleted Messages (Default: Pakistan Standard Time)
TIMEZONE="Asia/Karachi"

# ------------------------------------------------------------------------------
# 2. WHATSAPP SESSION AUTHENTICATION (واٹس ایپ سیشن آئی ڈی)
# ------------------------------------------------------------------------------
# Your exported base64/zipped WhatsApp session credentials (e.g. ZAID~...)
# Agar aap yahan SESSION_ID daal dein toh bot container restart hone par
# dobara QR scan ya phone pair kiye baghair foran connect ho jata hai!
SESSION_ID=""

# Optional API Security Secret for administrative control endpoints
API_SECRET="zaid-ashiq-secret-2026"

# ------------------------------------------------------------------------------
# 3. SERVER & NETWORKING (سرور اور پورٹ کنفیگریشن)
# ------------------------------------------------------------------------------
# Default listening port:
# - Root / Local Dev: 3000
# - Railway: 8080
# - Render: 10000
# - Heroku: Automatically assigned via dynamic $PORT
PORT=3000
NODE_ENV="production"

# Public HTTPS URL of your running backend (Used by Vercel frontend for API routing)
BACKEND_URL="http://localhost:3000"

# Specific Cloud Backend URLs (for multi-cloud interconnect)
RAILWAY_BACKEND_URL="https://your-bot-name.up.railway.app"
RENDER_BACKEND_URL="https://your-bot-name.onrender.com"
HEROKU_BACKEND_URL="https://your-bot-name.herokuapp.com"

# ------------------------------------------------------------------------------
# 4. CLOUDINARY MEDIA STORAGE (مستقل میڈیا اور ویڈیو/آڈیو نوٹس سٹوریج)
# ------------------------------------------------------------------------------
# Free permanent cloud storage for Video Notes (PTV), Voice Notes (PTT),
# Status stories, and Anti-Delete recovered photos & videos.
# Get free credentials at: https://cloudinary.com
# Option A: Single Connection URL
CLOUDINARY_URL=""

# Option B: Individual Credentials (agar URL na use karein)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ------------------------------------------------------------------------------
# 5. GITHUB AUTOMATED SESSION BACKUP (کلاؤڈ سیشن بیک اپ)
# ------------------------------------------------------------------------------
# GitHub Personal Access Token (PAT) with 'gist' or 'repo' scope.
# Railway ya Render par free dyno restart hone par creds.json ko mehfooz rakhta hai.
GITHUB_TOKEN=""

# Auto-created Gist ID after first backup (Leave blank on first run)
GITHUB_GIST_ID=""

# ------------------------------------------------------------------------------
# 6. GOOGLE IDENTITY (اختیاری: گوگل اکاؤنٹ سیشن لاکنگ)
# ------------------------------------------------------------------------------
# Google Cloud Console OAuth 2.0 Web Client ID (Optional)
GOOGLE_CLIENT_ID=""
