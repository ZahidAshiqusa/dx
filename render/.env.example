# ==============================================================================
# RENDER BACKEND - ENVIRONMENT VARIABLES (.env)
# Set these in your Render Web Service -> Environment Variables
# ==============================================================================

# Render Web Service Port (Default 10000)
PORT=10000
NODE_ENV="production"

# WhatsApp Session ID (Exported base64/zipped string from web dashboard)
# Is variable se Render Web Service restart hone par dobara connect rehti hai
SESSION_ID=""

# Bot Identity & Admin Privileges
BOT_NAME="ZAID ASHIQ STUDIO"
BOT_PREFIX="/"
OWNER_NUMBER="923001234567"
OWNER_NAME="Zahid Ashiq"
WORK_TYPE="public"
TIMEZONE="Asia/Karachi"

# Public Render Service Domain (Auto-assigned e.g. https://xyz.onrender.com)
RENDER_EXTERNAL_URL="https://your-bot-name.onrender.com"
RENDER_BACKEND_URL="https://your-bot-name.onrender.com"

# Optional Cloudinary Media Storage (For Video Notes, Voice Notes, Statuses)
CLOUDINARY_URL=""
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# Optional Automated Session Backup to GitHub Gist
GITHUB_TOKEN=""
GITHUB_GIST_ID=""
